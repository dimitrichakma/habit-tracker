<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. `manage.sh install` substitutes @@UV@@ / @@PROJECT_DIR@@ and
  installs the result into ~/Library/LaunchAgents/. Do not load this file
  directly.

  FastAPI backend (uvicorn on 127.0.0.1:8000), no --reload. The daily
  reminder scheduler runs in-process here, so this must stay up for
  reminders to fire.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dimitri.habit-tracker.backend</string>

    <key>ProgramArguments</key>
    <array>
        <string>@@UV@@</string>
        <string>run</string>
        <string>uvicorn</string>
        <string>src.main:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@@PROJECT_DIR@@</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- flush logs immediately instead of block-buffering to the file -->
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>@@PROJECT_DIR@@/logs/backend.out.log</string>
    <key>StandardErrorPath</key>
    <string>@@PROJECT_DIR@@/logs/backend.err.log</string>
</dict>
</plist>
