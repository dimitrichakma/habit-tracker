# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
# In deployment these are set through Railway (`railway variables`), not here.

# --- Required ---------------------------------------------------------------

# Claude — powers the coaching agent, the weekly behavioral summariser, and
# (for the eval suite) the LLM-as-a-Judge. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used ONLY for vector embeddings (text-embedding-3-small) of the
# weekly memory summaries. No text generation or judging runs through OpenAI.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Signs the app's JWTs. Generate once with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Telegram bot — token from @BotFather; numeric chat id from e.g. @userinfobot.
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# The single account the Telegram bot and the schedulers act as. Sign this
# account up through the Streamlit app first, then set the username to match.
# HABIT_TRACKER_PASSWORD is only the Streamlit login now (the bot doesn't
# log in any more).
HABIT_TRACKER_USERNAME=you
HABIT_TRACKER_PASSWORD=your-app-password

# --- Postgres (optional locally, required in deployment) ------------------
# PostgreSQL with the pgvector extension (e.g. Neon). Holds the relational
# tables, the agent's conversation checkpoints, and the weekly-summary
# vectors. LEAVE UNSET to run on a local SQLite file (no vector memory then).
#
#   DATABASE_URL         — Neon's POOLED endpoint (host has "-pooler")
#   DATABASE_URL_DIRECT   — Neon's un-pooled endpoint; the async checkpointer
#                           needs this (it uses prepared statements PgBouncer
#                           rejects). Falls back to DATABASE_URL if unset.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require

# --- Telegram webhook (required for the bot) -----------------------------
# The bot is a webhook now, not a polling process. TELEGRAM_WEBHOOK_URL is the
# backend's public https URL + /webhook/telegram (locally: a cloudflared /
# ngrok tunnel). WEBHOOK_SECRET_TOKEN is any random string — it's registered
# with setWebhook and checked on every incoming update.
# TELEGRAM_WEBHOOK_URL=https://your-backend.example.com/webhook/telegram
# WEBHOOK_SECRET_TOKEN=some-random-string

# --- Observability (Phase 6.1) ---------------------------------------
# LangSmith tracing. All OFF unless LANGSMITH_TRACING=true. A LangSmith
# outage never fails a request — trace export is out-of-band.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=habit-tracker
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Security & gateway (Phase 6) ----------------------------------
# Gate the public /auth/signup. When set, a signup request must send the same
# value in an X-Signup-Secret header (the Streamlit login screen has a field
# for it). Leave UNSET locally to keep signup open. Single-user app — this
# mainly matters if the database is ever rebuilt and the account recreated.
# SIGNUP_SECRET=some-long-random-string
#
# In-memory rate limits. slowapi strings for the HTTP routes; a plain int
# (per minute) for the Telegram webhook. Defaults shown; override only if needed.
# LOGIN_RATE_LIMIT=5/minute          # POST /auth/login, keyed by IP
# SIGNUP_RATE_LIMIT=3/minute         # POST /auth/signup, keyed by IP
# CHAT_RATE_LIMIT=20/minute          # POST /chat, keyed by authenticated user_id
# FRICTION_RATE_LIMIT=10/minute      # POST /evaluate_friction, keyed by IP
# TELEGRAM_RATE_LIMIT_PER_MIN=5      # POST /webhook/telegram, keyed by chat_id
#
# Per-message size cap, daily per-user token budget, and the hard timeout on
# a single agent turn.
# MAX_MESSAGE_CHARS=1000
# MAX_DAILY_QUOTA=200000             # input+output tokens per user per day
# AGENT_TIMEOUT_SECONDS=30
#
# AI guardrails (agent-side). GUARDRAIL_OUTPUT_LLM_CHECK toggles the extra
# Haiku semantic check on final replies (the regex checks always run).
# HARM_SUPPORT_RESOURCE overrides the support-resource text shown when the
# guardrail declines a harmful / self-harm / disordered-eating request —
# set it to a verified local crisis line if you have one.
# GUARDRAIL_TIMEOUT_SECONDS=8
# GUARDRAIL_OUTPUT_LLM_CHECK=1
# HARM_SUPPORT_RESOURCE=

# --- Integration tests (Phase 6) ---------------------------------
# A scratch Postgres+pgvector URL for `pytest tests/`. MUST NOT equal
# DATABASE_URL (asserted). Leave unset to let the suite spin up a throwaway
# Docker container instead (or skip if Docker is unavailable).
# TEST_DATABASE_URL=postgresql://user:pass@host/scratch_db?sslmode=require

# --- Optional (defaults shown) ------------------------------------------

# Wall-clock zone for the 8pm reminder and Sunday 23:59 weekly-summary jobs.
# REMINDER_TIMEZONE=Asia/Dhaka

# The frontend's backend URL (Streamlit Cloud sets this via app secrets).
# BACKEND_BASE_URL=http://localhost:8000

# The port the backend binds (Railway / Cloud Run inject this).
# PORT=8080

# pgvector collection name.
# HABIT_MEMORY_COLLECTION=habit_summaries
