# Copy to `.env` and fill in. `.env` is gitignored; this template is not.

# --- Required ---------------------------------------------------------------

# Claude — powers the coaching agent, the weekly behavioral summariser, and
# (for the eval suite) the LLM-as-a-Judge. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — used ONLY for vector embeddings (text-embedding-3-small) of the
# weekly memory summaries. No text generation or judging runs through OpenAI.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Signs the app's JWTs. Generate once with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Telegram bot — create a bot with @BotFather to get the token, then message
# the bot once and read your numeric chat id (e.g. from @userinfobot).
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHAT_ID=123456789

# The single account the Telegram bot and the schedulers act as. Sign this
# account up through the app (or Streamlit) first, then set these to match.
HABIT_TRACKER_USERNAME=you
HABIT_TRACKER_PASSWORD=your-app-password

# --- Optional (sensible defaults shown) -----------------------------------

# Wall-clock zone for the 8pm reminder and Sunday 23:59 weekly-summary jobs.
# REMINDER_TIMEZONE=Asia/Dhaka

# Where bot.py reaches the backend.
# BACKEND_BASE_URL=http://localhost:8000

# Local ChromaDB persist dir / collection name for the semantic memory.
# CHROMA_PATH=chroma_db
# HABIT_MEMORY_COLLECTION=habit_memory
